<mujoco>
  <compiler autolimits="true"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="8 8" texuniform="true"/>
  </asset>

  <default>
    <geom conaffinity="1" contype="1" condim="3" rgba="0.8 0.2 0.2 1"/>
    <joint damping="0.1"/>
  </default>

  <worldbody>
    <!-- 地面 -->
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

    <!-- 圆柱体机器人 -->
    <body name="robot" pos="0 0 0.1">
      <!-- 显式定义 3 个平面运动关节 -->
      <joint name="tx" type="slide" axis="1 0 0"/>   <!-- X 方向平移 -->
      <joint name="ty" type="slide" axis="0 1 0"/>   <!-- Y 方向平移 -->
      <joint name="rz" type="hinge" axis="0 0 1"/>   <!-- Z 轴旋转（偏航） -->

      <geom name="robot_body" type="cylinder" size="0.15 0.1"/>
      <site name="robot_front" pos="0.15 0 0" size="0.02" rgba="1 1 0 1"/>
    </body>
  </worldbody>

  <!-- 速度控制器 -->
  <actuator>
    <velocity name="vx" joint="tx" ctrlrange="-1 1" kv="200"/>
    <velocity name="vy" joint="ty" ctrlrange="-1 1" kv="200"/>
    <velocity name="wz" joint="rz" ctrlrange="-2 2" kv="50"/>
  </actuator>
</mujoco>