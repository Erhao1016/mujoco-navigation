<?xml version="1.0"?>
<package format="3">

  <name>mujoco_navigation</name>

  <version>0.0.1</version>

  <description>
    ROS2 communication package for MuJoCo navigation,
    A-star path planning and PD path following.
  </description>

  <maintainer email="your_email@example.com">
    yangerhao
  </maintainer>

  <license>MIT</license>

  <buildtool_depend>
    ament_python
  </buildtool_depend>

  <exec_depend>
    rclpy
  </exec_depend>

  <exec_depend>
    geometry_msgs
  </exec_depend>

  <exec_depend>
    nav_msgs
  </exec_depend>

  <exec_depend>
    python3-numpy
  </exec_depend>

  <test_depend>
    ament_flake8
  </test_depend>

  <test_depend>
    ament_pep257
  </test_depend>

  <test_depend>
    python3-pytest
  </test_depend>

  <export>
    <build_type>
      ament_python
    </build_type>
  </export>

</package>